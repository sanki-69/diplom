{
  "manifest_version": 3,
  "name": "AI Shopping Assistant",
  "version": "2.0.0",
  "description": "AI-powered Mongolian shopping assistant with floating chat widget",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "vite.svg",
    "48": "vite.svg",
    "128": "vite.svg"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
