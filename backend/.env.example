# Copy this file to .env and fill in what you need. Never commit .env.

# ── AI providers (at least one key) ──────────────────────────────
# Gemini — free: https://aistudio.google.com/  (also used for product embeddings)
GEMINI_API_KEY=
# Mistral — free "Experiment" plan: https://console.mistral.ai/
MISTRAL_API_KEY=
# OpenRouter — ~20 free models with one key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq — free, very fast: https://console.groq.com/
GROQ_API_KEY=

# Order for chat answers / quick helper calls (keyless providers are skipped)
AI_PROVIDER_ORDER=gemini,mistral,openrouter,groq,custom
AI_FAST_PROVIDER_ORDER=gemini,mistral,openrouter,groq,custom

# Model lists (each provider falls back through its list)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Any other OpenAI-compatible service (optional)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ── Database ─────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=aishop
# Atlas connection string, only for backup_to_atlas.py
ATLAS_URL=

# ── Security ─────────────────────────────────────────────────────
# Long random string. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Usernames that become admin when they sign up / log in
ADMIN_USERNAMES=
# Websites allowed to call the API ("*" is needed for the Chrome extension)
ALLOWED_ORIGINS=*
# Real visitor IP header behind a proxy: cf-connecting-ip on Render; empty locally
CLIENT_IP_HEADER=

# ── Optional ─────────────────────────────────────────────────────
# Proxy for shop scraping when stores block your server (http://user:pass@host:port)
SCRAPER_PROXY_URL=
# Rate-limit overrides, "count/seconds" pairs, e.g. RATE_CHAT=20/60,300/86400
# RATE_CHAT=
# GLOBAL_DAILY_CHAT=3000
